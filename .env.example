# Copy to .env.local and fill in your own Cisco DevNet sandbox credentials.
# .env.local is gitignored — never commit real values. This repo is public.
#
# Get credentials from https://devnetsandbox.cisco.com (always-on sandboxes).
# An adapter with missing values reports "not connected" — it never invents data.

# ── Server settings (all optional — the defaults are the safe ones) ──────────
# Where the squad workspace lives. Default: a "squad" folder inside this repo,
# created automatically on first run.
# SQUAD_ROOT=
# Which address to listen on. Default 127.0.0.1 (this machine only).
# Set to 0.0.0.0 only if you really mean to expose the dashboard.
# HOST=127.0.0.1
# PORT=3000
# Web pages allowed to call this server, comma separated.
# Default: http/https localhost and 127.0.0.1 on the port above.
# ALLOWED_ORIGINS=https://mission.example.com
# Request budgets per minute, per caller.
# RATE_LIMIT_READ=300
# RATE_LIMIT_WRITE=60
# RATE_LIMIT_WS=60

# Catalyst Center (campus switches, health, issues, Command Runner)
DNAC_HOST=sandboxdnac.cisco.com
DNAC_USER=
DNAC_PASS=

# ACI / APIC (Nexus fabric, tenants, faults)
ACI_HOST=sandboxapicdc.cisco.com
ACI_USER=
ACI_PASS=

# SD-WAN vManage (overlay routers, controllers, alarms)
SDWAN_HOST=sandbox-sdwan-2.cisco.com
SDWAN_USER=
SDWAN_PASS=

# Copy to .env.local and fill in your own Cisco DevNet sandbox credentials.
# .env.local is gitignored — never commit real values. This repo is public.
#
# Get credentials from https://devnetsandbox.cisco.com (always-on sandboxes).
# An adapter with missing values reports "not connected" — it never invents data.

# ── Server settings (all optional — the defaults are the safe ones) ──────────
# Where the squad workspace lives. Default: a "squad" folder inside this repo,
# created automatically on first run.
# SQUAD_ROOT=
# Which address to listen on. Default 127.0.0.1 (this machine only).
# Set to 0.0.0.0 only if you really mean to expose the dashboard.
# HOST=127.0.0.1
# PORT=3000
# Web pages allowed to call this server, comma separated.
# Default: http/https localhost and 127.0.0.1 on the port above.
# ALLOWED_ORIGINS=https://mission.example.com
# Request budgets per minute, per caller.
# RATE_LIMIT_READ=300
# RATE_LIMIT_WRITE=60
# RATE_LIMIT_WS=60

# Catalyst Center (campus switches, health, issues, Command Runner)
DNAC_HOST=sandboxdnac.cisco.com
DNAC_USER=
DNAC_PASS=

# ACI / APIC (Nexus fabric, tenants, faults)
ACI_HOST=sandboxapicdc.cisco.com
ACI_USER=
ACI_PASS=

# SD-WAN vManage (overlay routers, controllers, alarms)
SDWAN_HOST=sandbox-sdwan-2.cisco.com
SDWAN_USER=
SDWAN_PASS=

# ── Direct SSH runner (sources/ssh-runner.js + ssh_sidecar.py) ───────────────
# For DIRECTLY-REACHABLE devices only. The DNAC switches sw1-sw4 are private
# behind Catalyst Center and STAY on the Command Runner path — do NOT put them
# here. Requires a Python venv with scrapli+netmiko (.venv, gitignored):
#   py -3.11 -m venv .venv
#   .venv\Scripts\python -m pip install "scrapli[paramiko]" netmiko
#
# Always-on IOS-XE sandbox. NOTE (2026-08): DevNet retired the static public
# password on the always-on IOS-XE box — it now issues per-reservation creds.
# Reserve the sandbox at https://devnetsandbox.cisco.com and paste the current
# username/password here. With stale creds the runner reports an honest
# "auth failed", never a fabricated result.
SSH_IOSXE_HOST=sandbox-iosxe-latest-1.cisco.com
SSH_IOSXE_PORT=22
SSH_IOSXE_USER=
SSH_IOSXE_PASS=

# Optional second directly-reachable always-on sandbox (Nexus / NX-OS).
SSH_NXOS_HOST=sbx-nxos-mgmt.cisco.com
SSH_NXOS_PORT=22
SSH_NXOS_USER=
SSH_NXOS_PASS=

# Optional third directly-reachable always-on sandbox (IOS XR).
# Documented SSH port is 8181, but that port is often filtered on corporate
# networks — SSH on 22 also answers. Use whichever your network can reach.
SSH_IOSXR_HOST=sbx-iosxr-mgmt.cisco.com
SSH_IOSXR_PORT=22
SSH_IOSXR_USER=
SSH_IOSXR_PASS=

# Per-command SSH timeout in seconds (optional; default 30).
# SSH_TIMEOUT=30
# Override the sidecar Python interpreter (optional; default = ./.venv).
# SSH_PYTHON=

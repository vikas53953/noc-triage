# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real credentials or API keys.
#
# Nothing here is required to start the app. Anything you leave blank simply
# reports "not connected" — the app never invents data to fill a gap.
#
# Cisco sandbox logins come from https://devnetsandbox.cisco.com (free, always-on).

# ── Network sources (the live data behind the agents) ───────────────────────
# Catalyst Center — campus switches, health scores, open issues, and the
# Command Runner that executes real read-only CLI on those switches.
DNAC_HOST=sandboxdnac.cisco.com
DNAC_USER=
DNAC_PASS=

# ACI / APIC — Nexus data-centre fabric: nodes, tenants, faults.
ACI_HOST=sandboxapicdc.cisco.com
ACI_USER=
ACI_PASS=

# SD-WAN vManage — overlay routers, controllers, alarms.
SDWAN_HOST=sandbox-sdwan-2.cisco.com
SDWAN_USER=
SDWAN_PASS=

# ── Jarvis (the AI copilot) ─────────────────────────────────────────────────
# Your Anthropic API key. Without it Jarvis says it is offline instead of
# guessing. The key is never written to logs or to disk — only its presence
# is checked.
ANTHROPIC_API_KEY=

# Which Claude model Jarvis thinks with. Default: claude-opus-5.
# Set this only if you want a cheaper/faster tier (e.g. claude-sonnet-5).
# JARVIS_MODEL=claude-opus-5

# How long to wait for one Claude reply before giving up, in milliseconds.
# Default 60000 (one minute).
# CLAUDE_TIMEOUT_MS=60000

# ── Server settings (all optional — the defaults are the safe ones) ─────────
# Where the working folder lives (documents and records the agents write).
# Default: a "squad" folder inside this repo, created on first run.
# SQUAD_ROOT=

# Which address to listen on. Default 127.0.0.1 (this machine only).
# Set to 0.0.0.0 only if you really mean to expose the console on your network.
# HOST=127.0.0.1

# Which port to serve on. Default 3000.
# PORT=3000

# Web pages allowed to call this server, comma separated.
# Default: http/https localhost and 127.0.0.1 on the port above.
# ALLOWED_ORIGINS=https://noc.example.com

# ── Request budgets (protect the sandboxes from a runaway loop) ─────────────
# Requests allowed per caller per window. Window default 60000 ms (one minute).
# RATE_LIMIT_READ=300
# RATE_LIMIT_WRITE=60
# RATE_LIMIT_WS=60
# RATE_LIMIT_WINDOW_MS=60000

# ── Triage behaviour ───────────────────────────────────────────────────────
# How many devices the triage engine pulls a running-config from in one sweep.
# Default 4 — raise it only if your sandbox can take the load.
# TRIAGE_CONFIG_MAX=4

# How long to wait for one running-config read, in milliseconds. Default 120000.
# TRIAGE_CONFIG_TIMEOUT_MS=120000

# Pause between triage steps, in milliseconds, so the bridge reads at human
# speed instead of flashing past. Default 350.
# TRIAGE_STEP_MS=350

# Time window used to link events across domains ("the WAN alarm and the fabric
# fault started together"), in milliseconds. Default 600000 (ten minutes);
# minimum 60000.
# CORRELATION_WINDOW_MS=600000

# ── Escalation and paging ──────────────────────────────────────────────────
# Webhook URL the on-call notifier posts to (Slack / Teams / PagerDuty inbound).
# Left blank, paging honestly reports "not configured" instead of pretending.
# ONCALL_WEBHOOK=

# Safety valve for the permission gate. OFF by default: a pending approval waits
# for a human forever. Set a positive number of milliseconds and an undecided
# approval auto-DENIES after that long (denied = nothing runs). Blank, zero, or
# a bad value = off.
# APPROVAL_TIMEOUT_MS=

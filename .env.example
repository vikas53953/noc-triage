# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real credentials or API keys.
#
# Nothing here is required to start the app. Anything you leave blank simply
# reports "not connected" — the app never invents data to fill a gap.
#
# Cisco sandbox logins come from https://devnetsandbox.cisco.com (free, always-on).

# ── Network sources (the live data behind the agents) ───────────────────────
# Catalyst Center — campus switches, health scores, open issues, and the
# Command Runner that executes real read-only CLI on those switches.
DNAC_HOST=sandboxdnac.cisco.com
DNAC_USER=
DNAC_PASS=

# ACI / APIC — Nexus data-centre fabric: nodes, tenants, faults.
ACI_HOST=sandboxapicdc.cisco.com
ACI_USER=
ACI_PASS=

# SD-WAN vManage — overlay routers, controllers, alarms.
SDWAN_HOST=sandbox-sdwan-2.cisco.com
SDWAN_USER=
SDWAN_PASS=

# ── Jarvis (the AI copilot) ─────────────────────────────────────────────────
# Your Anthropic API key. Without it Jarvis says it is offline instead of
# guessing. The key is never written to logs or to disk — only its presence
# is checked.
ANTHROPIC_API_KEY=

# Which Claude model Jarvis thinks with. Default: claude-opus-5.
# Set this only if you want a cheaper/faster tier (e.g. claude-sonnet-5).
# JARVIS_MODEL=claude-opus-5

# How long to wait for one Claude reply before giving up, in milliseconds.
# Default 60000 (one minute).
# CLAUDE_TIMEOUT_MS=60000

# ── Server settings (all optional — the defaults are the safe ones) ─────────
# Where the working folder lives (documents and records the agents write).
# Default: a "squad" folder inside this repo, created on first run.
# SQUAD_ROOT=

# Which address to listen on. Default 127.0.0.1 (this machine only).
# Set to 0.0.0.0 only if you really mean to expose the console on your network.
# HOST=127.0.0.1

# Which port to serve on. Default 3000.
# PORT=3000

# Web pages allowed to call this server, comma separated.
# Default: http/https localhost and 127.0.0.1 on the port above.
# ALLOWED_ORIGINS=https://noc.example.com

# ── Request budgets (protect the sandboxes from a runaway loop) ─────────────
# Requests allowed per caller per window. Window default 60000 ms (one minute).
# RATE_LIMIT_READ=300
# RATE_LIMIT_WRITE=60
# RATE_LIMIT_WS=60
# RATE_LIMIT_WINDOW_MS=60000

# ── Triage behaviour ───────────────────────────────────────────────────────
# How many devices the triage engine pulls a running-config from in one sweep.
# Default 4 — raise it only if your sandbox can take the load.
# TRIAGE_CONFIG_MAX=4

# How long to wait for one running-config read, in milliseconds. Default 120000.
# TRIAGE_CONFIG_TIMEOUT_MS=120000

# Pause between triage steps, in milliseconds, so the bridge reads at human
# speed instead of flashing past. Default 350.
# TRIAGE_STEP_MS=350

# Time window used to link events across domains ("the WAN alarm and the fabric
# fault started together"), in milliseconds. Default 600000 (ten minutes);
# minimum 60000.
# CORRELATION_WINDOW_MS=600000

# ── Escalation and paging ──────────────────────────────────────────────────
# Webhook URL the on-call notifier posts to (Slack / Teams / PagerDuty inbound).
# Left blank, paging honestly reports "not configured" instead of pretending.
# ONCALL_WEBHOOK=

# Safety valve for the permission gate. OFF by default: a pending approval waits
# for a human forever. Set a positive number of milliseconds and an undecided
# approval auto-DENIES after that long (denied = nothing runs). Blank, zero, or
# a bad value = off.
# APPROVAL_TIMEOUT_MS=

# ── Direct SSH runner (sources/ssh-runner.js + ssh_sidecar.py) ───────────────
# For DIRECTLY-REACHABLE devices only. The DNAC switches sw1-sw4 are private
# behind Catalyst Center and STAY on the Command Runner path — do NOT put them
# here. Requires a Python venv with scrapli+netmiko (.venv, gitignored):
#   py -3.11 -m venv .venv
#   .venv\Scripts\python -m pip install "scrapli[paramiko]" netmiko
#
# Always-on IOS-XE sandbox. NOTE (2026-08): DevNet retired the static public
# password on the always-on IOS-XE box — it now issues per-reservation creds.
# Reserve the sandbox at https://devnetsandbox.cisco.com and paste the current
# username/password here. With stale creds the runner reports an honest
# "auth failed", never a fabricated result.
SSH_IOSXE_HOST=sandbox-iosxe-latest-1.cisco.com
SSH_IOSXE_PORT=22
SSH_IOSXE_USER=
SSH_IOSXE_PASS=

# Optional second directly-reachable always-on sandbox (Nexus / NX-OS).
SSH_NXOS_HOST=sbx-nxos-mgmt.cisco.com
SSH_NXOS_PORT=22
SSH_NXOS_USER=
SSH_NXOS_PASS=

# Optional third directly-reachable always-on sandbox (IOS XR).
# Documented SSH port is 8181, but that port is often filtered on corporate
# networks — SSH on 22 also answers. Use whichever your network can reach.
SSH_IOSXR_HOST=sbx-iosxr-mgmt.cisco.com
SSH_IOSXR_PORT=22
SSH_IOSXR_USER=
SSH_IOSXR_PASS=

# Per-command SSH timeout in seconds (optional; default 30). The watchdog is
# this plus a small margin — not a flat +45s.
# SSH_TIMEOUT=30
# Override the sidecar Python interpreter (optional; default = ./.venv).
# SSH_PYTHON=
# Max concurrent SSH sidecar processes (optional; default 4).
# SSH_MAX_CONCURRENT=4
# Max bytes of device output kept per command (optional; default 1048576).
# "show tech-support" is a legal read that runs to megabytes; truncation is
# announced on the result (truncated:true), never silent.
# SSH_MAX_OUTPUT_BYTES=1048576

# SSH host-key policy: 1 (strict) | 0 (off) | auto (default).
# Any other value is REFUSED before dialling — a typo like "ture" must not
# silently disable host-key verification.
#
# "auto" = strict once the host is pinned in known_hosts, permissive on first
# contact, so a throwaway public sandbox works out of the box. IMPORTANT: the
# sidecar never WRITES a host key, so on a fresh machine "auto" stays permissive
# forever until you pin the host yourself:
#
#     ssh-keyscan -H sandbox-iosxe-latest-1.cisco.com >> ~/.ssh/known_hosts
#     ssh-keyscan -H -p 8181 sbx-iosxr-mgmt.cisco.com >> ~/.ssh/known_hosts
#
# (Pin over a network you trust — keyscan itself is trust-on-first-use.) Once
# pinned, "auto" verifies that host on every dial and a mismatch is refused with
# kind:"hostkey". Set SSH_STRICT_KEY=1 the moment a REAL device credential goes
# in here — without verification an on-path impostor harvests it on first dial.
# SSH_STRICT_KEY=auto
# Path to a known_hosts file (optional; default ~/.ssh/known_hosts).
# SSH_KNOWN_HOSTS=

# ── A4: native syslog + SNMP-trap live feeds ─────────────────────────────────
# Two NATIVE Node UDP receivers turn real device events into timestamped
# evidence the bridge reasons over. BOTH ARE OFF BY DEFAULT — unset means the
# status route honestly reports "not receiving / not configured" and the
# live-events store stays empty. Nothing is ever fabricated.
#
# Enable a feed with its *_ENABLED flag (an explicit *_ENABLED=0 keeps it off
# even if a port is set). Ports default HIGH (5514 / 1620) so no root/admin is
# needed to bind; use the real well-known ports (514 / 162) only if you run the
# process with the privilege to bind them.
#
# To receive REAL events: point a device's logging/trap host at THIS machine's
# IP and the port below, and set SYSLOG_BIND/SNMPTRAP_BIND=0.0.0.0 so the
# listener accepts datagrams from off-box (default 127.0.0.1 is localhost only).
#   Cisco IOS example:  logging host <this-ip> transport udp port 5514
#                       snmp-server host <this-ip> traps version 2c <community> udp-port 1620
# SYSLOG_ENABLED=1
# SYSLOG_PORT=5514
# SYSLOG_BIND=127.0.0.1
# SNMPTRAP_ENABLED=1
# SNMPTRAP_PORT=1620
# SNMPTRAP_BIND=127.0.0.1
# LIVE_EVENTS_CAP=500     # ring-buffer size for recent events (default 500)

# ── External MCP tools (CW-8 connector; CW-13 wires NetClaw) ────────────────
# NetClaw (https://github.com/automateyournetwork/netclaw) ships ~54 read-only
# network MCP servers. The first one wired is catc-mcp (Catalyst Center, all
# 514 read-only operations). scripts/netclaw-setup.ps1 (Windows) or
# scripts/netclaw-setup.sh clones it and builds the small Python venv, then
# prints these two lines. Its Catalyst Center login is taken from DNAC_* above
# (mapped by name in config/mcp-servers.json — no value is ever in that file).
# NETCLAW_DIR=C:\Users\vikasmit\netclaw
# NETCLAW_PYTHON=C:\Users\vikasmit\netclaw-venv\Scripts\python.exe
# The server list itself lives in config/mcp-servers.json (gitignored) — start
# from config/mcp-servers.example.json and set "enabled": true.
